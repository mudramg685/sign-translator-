# Copy to .env for local use. Replace these values with your local MySQL setup.
MYSQL_DATABASE=isl_translator
MYSQL_USER=isl_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_PORT=3306

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:${MYSQL_PORT}/${MYSQL_DATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=${MYSQL_USER}
SPRING_DATASOURCE_PASSWORD=${MYSQL_PASSWORD}
ML_SERVICE_BASE_URL=http://localhost:8000
ML_CONFIDENCE_THRESHOLD=0.70
